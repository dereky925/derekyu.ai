# Canonical production URL (used for sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://derekyu.ai

# Optional public media origin with no trailing slash.
# After you upload files to Cloudflare R2 (or a custom domain in front of it):
#   NEXT_PUBLIC_MEDIA_BASE_URL=https://media.derekyu.ai
# Then set a project's video.src to a key like "projects/grokeye/demo.mp4"
NEXT_PUBLIC_MEDIA_BASE_URL=

# Optional — shown on the About page when set
NEXT_PUBLIC_EMAIL=
